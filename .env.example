# ============================================
# EMAIL CONFIGURATION - CHOOSE ONE OPTION
# ============================================
# Copy this file as .env.local in the project root

# --------------------------------------------
# OPTION 1: Web3Forms (RECOMMENDED - FASTEST)
# --------------------------------------------
# Setup in 2 minutes
# 1. Go to https://web3forms.com
# 2. Enter your email: juanrafaelcalzada1087@gmail.com
# 3. Click Create Access Key
# 4. Copy the key and paste it here:

NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# --------------------------------------------
# OPTION 2: EmailJS (Alternative)
# --------------------------------------------
# Takes ~10 minutes to setup

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here

# --------------------------------------------
# OPTION 3: Resend API (RECOMMENDED - Allows sending to any email)
# --------------------------------------------
# Resend API Key for email sending
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Sender email (OPTIONAL but RECOMMENDED for sending to any email)
# IMPORTANT: To send to ANY email, you need to verify a domain in Resend
RESEND_FROM_EMAIL=contacto@yourdomain.com

# Default contact email (used if no destination email is specified)
CONTACT_EMAIL=juanrafaelcalzada1087@gmail.com

# --------------------------------------------
# EMAIL VERIFICATION (OPTIONAL BUT RECOMMENDED)
# --------------------------------------------
# Abstract API Key to verify if emails exist
ABSTRACT_API_KEY=your_abstract_api_key_here
